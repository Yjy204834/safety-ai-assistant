page{font-family:-apple-system,BlinkMacSystemFont,SF Pro Display,SF Pro Text,PingFang SC,Hiragino Sans GB,Microsoft YaHei,sans-serif;font-size:28rpx;color:#0f172a;background-color:#f8fafc;line-height:1.5;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;text-rendering:optimizeLegibility}.container{min-height:100vh;background-color:#f8fafc;width:100%}.page-content{padding-bottom:calc(100rpx + env(safe-area-inset-bottom));min-height:100vh;width:100%}.section{padding:0 16px;margin-bottom:24px}.section-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;padding:0 8rpx}.section-title{font-size:34rpx;font-weight:700;color:#0f172a;letter-spacing:-.5px}.section-subtitle{font-size:24rpx;color:#64748b;margin-top:4px}.card{background:#fff;border-radius:18px;box-shadow:0 2px 8px rgba(15,23,42,.04),0 1px 4px rgba(15,23,42,.02);border:1px solid rgba(0,0,0,.04);padding:16px;transition:all .15s cubic-bezier(.4,0,.2,1)}.card-sm{padding:12px}.card-lg{padding:20px}.card-glass{background:rgba(255,255,255,.12);backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);border-radius:18px;border:1px solid rgba(255,255,255,.2)}.card-elevated{background:linear-gradient(135deg,rgba(255,255,255,.98),rgba(255,255,255,.96));border-radius:18px;box-shadow:0 4px 8px -1px rgba(15,23,42,.08),0 2px 4px -2px rgba(15,23,42,.05);border:1px solid rgba(0,0,0,.04)}.card-hover{background:#fff;border-radius:18px;box-shadow:0 2px 8px rgba(15,23,42,.04),0 1px 4px rgba(15,23,42,.02);border:1px solid rgba(0,0,0,.04);cursor:pointer;transition:all .3s cubic-bezier(.34,1.56,.64,1)}.btn-primary{display:flex;align-items:center;justify-content:center;height:88rpx;padding:0 48rpx;background:linear-gradient(135deg,#1e40af,#2563eb,#3b82f6);border-radius:32rpx;font-size:28rpx;font-weight:600;color:#fff;border:none;cursor:pointer;transition:all .15s cubic-bezier(.4,0,.2,1);box-shadow:0 2px 4px rgba(15,23,42,.06),0 1px 2px -1px rgba(15,23,42,.04)}.btn-secondary{display:flex;align-items:center;justify-content:center;height:88rpx;padding:0 48rpx;background:#f1f5f9;border-radius:32rpx;font-size:28rpx;font-weight:500;color:#334155;border:none;cursor:pointer;transition:all .15s cubic-bezier(.4,0,.2,1)}.btn-glass{display:flex;align-items:center;justify-content:center;height:80rpx;padding:0 32rpx;background:rgba(255,255,255,.12);backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);border-radius:24rpx;font-size:26rpx;font-weight:500;color:rgba(255,255,255,.98);border:1px solid rgba(255,255,255,.2);cursor:pointer;transition:all .15s cubic-bezier(.4,0,.2,1)}.input-field{width:100%;height:88rpx;padding:0 24rpx;background:#f1f5f9;border-radius:28rpx;font-size:28rpx;color:#0f172a;transition:all .15s cubic-bezier(.4,0,.2,1);border:2px solid transparent}.input-field:focus{background:#fff;border-color:#1e40af;box-shadow:0 0 24px rgba(59,130,246,.2)}.tag{display:inline-flex;align-items:center;padding:4px 8px;border-radius:9999px;font-size:11px;font-weight:500}.tag-success{background:rgba(16,185,129,.1);color:#10b981}.tag-warning{background:rgba(245,158,11,.1);color:#f59e0b}.tag-error{background:rgba(239,68,68,.1);color:#ef4444}.tag-info{background:rgba(59,130,246,.1);color:#3b82f6}.tag-primary{background:rgba(30,64,175,.1);color:#1e40af}.badge{display:inline-flex;align-items:center;justify-content:center;min-width:32rpx;height:32rpx;padding:0 8rpx;border-radius:9999px;font-size:20rpx;font-weight:600;background:#ef4444;color:#fff}.divider{height:1px;background:#e2e8f0;margin:20px 0}.divider-subtle{height:1px;background:rgba(0,0,0,.04);margin:12px 0}.text-gradient{background:linear-gradient(135deg,#1e40af,#3b82f6);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}.flex{display:flex}.flex-center{display:flex;align-items:center;justify-content:center}.flex-between{display:flex;align-items:center;justify-content:space-between}.flex-column{display:flex;flex-direction:column}.flex-1{flex:1}.mt-xs{margin-top